{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Carlector",
  "version": "0.1.0",
  "identifier": "cl.emilecid.carlector",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Carlector", "width": 1360, "height": 860, "minWidth": 900, "minHeight": 620 }],
    "security": { "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "targets": ["app", "dmg", "appimage"],
    "category": "Education",
    "shortDescription": "Carlector, lector local asistido para PDF, EPUB y Markdown",
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "contentTypes": ["com.adobe.pdf"],
        "name": "Documento PDF",
        "role": "Viewer"
      },
      {
        "ext": ["epub"],
        "contentTypes": ["org.idpf.epub-container"],
        "name": "Libro EPUB",
        "role": "Viewer"
      },
      {
        "ext": ["md", "markdown"],
        "contentTypes": ["net.daringfireball.markdown"],
        "name": "Documento Markdown",
        "role": "Viewer"
      }
    ],
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    }
  }
}
